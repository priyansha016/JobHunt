{
  "manifest_version": 3,
  "name": "LinkedIn Network Booster (Laya Auto-Pilot)",
  "version": "1.1.0",
  "description": "Autonomous LinkedIn network expansion and connection booster powered by Laya System 1 Decisions and DuckDB.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "content/profiler.js",
        "content/search_automation.js"
      ],
      "css": [
        "content/profiler.css",
        "content/search_automation.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
